# Copy to the repository root as .env and change every secret. Never commit .env.
POSTGRES_DB=oci
POSTGRES_USER=oci
POSTGRES_PASSWORD=change-me-strong-password
# Demo mode: simulated chains, fictitious labels, a generated admin key printed once in the logs. false in production.
OCI_DEMO_MODE=true
# Generate: openssl rand -base64 48 (required outside demo mode, otherwise API keys do not survive a restart)
OCI_SECURITY_API_KEY_PEPPER=
# OIDC issuer (leave empty in demo mode)
OCI_SECURITY_OIDC_ISSUER_URI=
# Telegram bot token for TELEGRAM connectors (leave empty to disable the channel)
OCI_TELEGRAM_BOT_TOKEN=
GRAFANA_ADMIN_PASSWORD=change-me
