# Copy to the repository root as .env and change every secret. Never commit .env.
POSTGRES_DB=oci
POSTGRES_USER=oci
POSTGRES_PASSWORD=change-me-strong-password
# Demo mode: simulated chains, fictitious labels, a generated admin key printed once in the logs. false in production.
OCI_DEMO_MODE=true
# Generate: openssl rand -base64 48. REQUIRED outside demo mode (the app refuses to start without it). Keep it stable:
# changing it invalidates every stored API key.
OCI_SECURITY_API_KEY_PEPPER=
# Generate: openssl rand -base64 32 (32 random bytes). AES-256-GCM key encrypting connector secrets in PostgreSQL.
# REQUIRED outside demo mode (docker-compose.yml otherwise passes a public dev-only key, refused when OCI_DEMO_MODE=false).
# Store it in your secret manager and back it up separately from the database: without it, stored connector secrets are lost.
OCI_CRYPTO_MASTER_KEY=
# OIDC issuer (leave empty in demo mode)
OCI_SECURITY_OIDC_ISSUER_URI=
# Telegram bot token for TELEGRAM connectors (leave empty to disable the channel)
OCI_TELEGRAM_BOT_TOKEN=
GRAFANA_ADMIN_PASSWORD=change-me
