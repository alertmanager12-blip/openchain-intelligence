# Copy to the repository root as .env and change every secret. Never commit .env.
POSTGRES_DB=oci
POSTGRES_USER=oci
POSTGRES_PASSWORD=change-me-strong-password
OCI_DEMO_MODE=true
OCI_ROLES=api,worker
# Generate: openssl rand -base64 32
OCI_CRYPTO_MASTER_KEY=
# Generate: openssl rand -base64 48
OCI_SECURITY_API_KEY_PEPPER=
# OIDC issuer (leave empty in demo mode)
OCI_SECURITY_OIDC_ISSUER_URI=
GRAFANA_ADMIN_PASSWORD=change-me
