# Copy to the repository root as .env (cp deploy/.env.example .env), then edit. Never commit .env (it is git-ignored).
# Every value below is read by docker-compose.yml. Leave a line empty to use the default.

# --- Mode ---------------------------------------------------------------------------------------------------------
# true  = demo: simulated TRON + Ethereum chains, fictitious labels, a generated admin key printed once in the logs.
# false = production: real chains only, no demo data, admin key from OCI_ADMIN_API_KEY below.
OCI_DEMO_MODE=false

# --- Database -----------------------------------------------------------------------------------------------------
POSTGRES_DB=oci
POSTGRES_USER=oci
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-password

# --- Secrets (REQUIRED when OCI_DEMO_MODE=false: the app refuses to start without them) ---------------------------
# AES-256-GCM key encrypting connector secrets in PostgreSQL. Generate: openssl rand -base64 32
# Back it up separately from the database: without it, stored connector secrets are lost.
OCI_CRYPTO_MASTER_KEY=
# Pepper for API key hashing. Generate: openssl rand -base64 48. Keep it stable: changing it invalidates every API key.
OCI_SECURITY_API_KEY_PEPPER=

# --- Administrator access (production) ----------------------------------------------------------------------------
# Format: oci_live_<8 letters/digits>_<43 letters/digits>. Generate with:
#   echo "oci_live_$(LC_ALL=C tr -dc A-Za-z0-9 </dev/urandom | head -c 8)_$(LC_ALL=C tr -dc A-Za-z0-9 </dev/urandom | head -c 43)"
# Paste it in the console (Settings > Connection > API key). Only its hash is stored. Create narrower keys in Settings.
OCI_ADMIN_KEY_NAME=admin
OCI_ADMIN_API_KEY=

# --- Real chains --------------------------------------------------------------------------------------------------
# Ethereum: any JSON-RPC endpoint (your node, Alchemy, Infura...). Public endpoints work for a first try but are
# rate-limited (example: https://ethereum-rpc.publicnode.com).
OCI_CHAINS_ETHEREUM_ENABLED=false
OCI_CHAINS_ETHEREUM_URL=
# TRON: TronGrid-compatible API. A free key from trongrid.io raises the rate limits (sent as TRON-PRO-API-KEY).
OCI_CHAINS_TRON_ENABLED=false
OCI_CHAINS_TRON_URL=https://api.trongrid.io
OCI_CHAINS_TRON_API_KEY=
# First block indexed when nothing was indexed yet; negative = head minus that many blocks.
# OCI_CHAINS_ETHEREUM_START_BLOCK=-100
# OCI_CHAINS_TRON_START_BLOCK=-100

# --- Optional -----------------------------------------------------------------------------------------------------
# OIDC issuer for user sign-in with your identity provider (leave empty to use API keys only)
OCI_SECURITY_OIDC_ISSUER_URI=
# Telegram bot token for TELEGRAM connectors (leave empty to disable the channel)
OCI_TELEGRAM_BOT_TOKEN=
# Grafana admin password for the optional observability profile
GRAFANA_ADMIN_PASSWORD=change-me
