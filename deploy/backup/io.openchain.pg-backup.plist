<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd job: runs deploy/backup/pg-backup.sh every day at 03:30 and at load.
  Install (replace /ABSOLUTE/PATH/TO/ChainSentinel and USER):
    cp deploy/backup/io.openchain.pg-backup.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/io.openchain.pg-backup.plist
  Remove:
    launchctl unload ~/Library/LaunchAgents/io.openchain.pg-backup.plist && rm ~/Library/LaunchAgents/io.openchain.pg-backup.plist
  On Linux use cron instead:  30 3 * * *  /path/to/ChainSentinel/deploy/backup/pg-backup.sh
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>io.openchain.pg-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/ABSOLUTE/PATH/TO/ChainSentinel/deploy/backup/pg-backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/io.openchain.pg-backup.out</string>
  <key>StandardErrorPath</key><string>/tmp/io.openchain.pg-backup.err</string>
</dict>
</plist>
